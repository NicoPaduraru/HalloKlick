# Vorlage für die Einstellungen auf dem Server.
# Kopieren nach ".env" und ausfüllen. Die Datei .env gehört NIE ins Git-Repository.

# Domain, unter der die App erreichbar ist (ohne https://)
DOMAIN=beispiel.de

# Langes, zufälliges Passwort für die Datenbank
DB_PASSWORD=

# Geheimer Schlüssel für die interne Kosten-Übersicht (mindestens 20 Zeichen). Leer = abgeschaltet.
INTERN_TOKEN=

# ---------- KI (Claude API) ----------
# Die KI läuft nur, wenn KI_AKTIV=true ist, ein Schlüssel da ist UND das Monatsbudget über 0 liegt.
KI_AKTIV=false
ANTHROPIC_API_KEY=
# Modell: claude-opus-5-5 (beste Qualität) oder claude-haiku-5-5 (günstiger). Entscheidung nach dem Modellvergleich.
KI_MODELL=claude-opus-5-5
# Preise in US-Dollar pro 1 Million Tokens, passend zum Modell (vor dem Start bei Anthropic prüfen)
KI_PREIS_EINGABE=4.00
KI_PREIS_AUSGABE=20.00
# Höchstens so viele KI-Checks pro Person und Tag
KI_TAGESLIMIT=10
# OFFENE ENTSCHEIDUNG: Monatsbudget in US-Dollar. Ist es erreicht, läuft nur noch die Regel-Prüfung.
KI_MONATSBUDGET_USD=0

# ---------- Web Push (Benachrichtigung der Angehörigen) ----------
# Schlüsselpaar erzeugen: siehe docs/BETRIEB.md. Leer = kein Web Push.
PUSH_OEFFENTLICH=
PUSH_PRIVAT=
PUSH_BETREFF=mailto:kontakt@beispiel.de

# ---------- E-Mail (Ersatz, wenn Web Push nicht geht) ----------
# Leer = keine E-Mails.
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_ABSENDER=

# ---------- Backup ----------
# Passwort, mit dem die Backups verschlüsselt werden. Gut aufbewahren: Ohne es ist kein Backup lesbar.
BACKUP_PASSWORT=
